<?xml version="1.0" encoding="utf-8"?>
<!-- Top bar: faint indigo wash fading down, with a hairline underneath. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#0A0916"
                android:startColor="#161338" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#1E1B3A" />
        </shape>
    </item>
</layer-list>
