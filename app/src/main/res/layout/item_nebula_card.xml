<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <FrameLayout
        android:id="@+id/nb_card_frame"
        android:layout_width="120dp"
        android:layout_height="180dp"
        android:background="@drawable/bg_nb_card_focus"
        android:clickable="true"
        android:focusable="true"
        android:padding="3dp">

        <ImageView
            android:id="@+id/nb_card_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <ProgressBar
            android:id="@+id/nb_card_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:max="1000"
            android:progressTint="#22D3EE"
            android:progressBackgroundTint="#40000000"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/nb_card_title"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/nb_card_sub"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#8A87B0"
        android:textSize="10sp" />
</LinearLayout>
