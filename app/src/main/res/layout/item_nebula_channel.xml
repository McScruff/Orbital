<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nb_ch_root"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:background="@drawable/bg_nb_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <TextView
        android:id="@+id/nb_ch_num"
        android:layout_width="34dp"
        android:layout_height="wrap_content"
        android:textColor="#6E6B95"
        android:textSize="11sp" />

    <ImageView
        android:id="@+id/nb_ch_logo"
        android:layout_width="44dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nb_ch_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nb_ch_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#9C99C0"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/nb_ch_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="3dp"
            android:max="1000"
            android:progressTint="#7C6CFF"
            android:progressBackgroundTint="#2A2750"
            android:visibility="invisible" />
    </LinearLayout>

    <TextView
        android:id="@+id/nb_ch_fav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="♥"
        android:textColor="#FF5C97"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
