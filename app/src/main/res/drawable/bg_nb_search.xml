<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#12112A" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#7C6CFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0E0D22" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#2A2750" />
        </shape>
    </item>
</selector>
